# Import necessary libraries
import pandas as pd
import matplotlib.pyplot as plt

# Load the CSV file
df = pd.read_csv('uploads/sales.csv')

# Step 1: Filter the data by product line and calculate the total revenue for each product line
revenue_by_product = df.groupby('product')['revenue'].sum().reset_index()

# Step 2: Filter the data by product line and calculate the total units sold for each product line
units_by_product = df.groupby('product')['units'].sum().reset_index()

# Step 3: Compare the total revenue and units sold for each product line
max_revenue_product = revenue_by_product.loc[revenue_by_product['revenue'].idxmax()]['product']
max_units_product = units_by_product.loc[units_by_product['units'].idxmax()]['product']

print(f"Product line with the most revenue: {max_revenue_product}")
print(f"Product line with the most units sold: {max_units_product}")

# Step 4: Visualize the results using a bar chart
fig, ax = plt.subplots(1, 2, figsize=(12, 6))

ax[0].bar(revenue_by_product['product'], revenue_by_product['revenue'])
ax[0].set_title('Total Revenue by Product Line')
ax[0].set_xlabel('Product Line')
ax[0].set_ylabel('Total Revenue')

ax[1].bar(units_by_product['product'], units_by_product['units'])
ax[1].set_title('Total Units Sold by Product Line')
ax[1].set_xlabel('Product Line')
ax[1].set_ylabel('Total Units Sold')

plt.tight_layout()
plt.savefig('outputs/revenue_vs_units.png')

# Print key numeric findings
print("Total Revenue by Product Line:")
print(revenue_by_product)
print("\nTotal Units Sold by Product Line:")
print(units_by_product)