# Import necessary libraries
import pandas as pd
import matplotlib.pyplot as plt
import matplotlib.dates as mdates
import numpy as np

# Load the sales.csv file
def load_data(file_name):
    try:
        data = pd.read_csv(file_name)
        return data
    except Exception as e:
        print(f"Failed to load data: {e}")

# Convert date to datetime format and extract month and year
def prepare_data(data):
    data['date'] = pd.to_datetime(data['date'])
    data['month'] = data['date'].dt.to_period('M')
    return data

# Group data by product and month to calculate total revenue
def calculate_revenue(data):
    revenue_data = data.groupby(['product', 'month'])['revenue'].sum().reset_index()
    return revenue_data

# Calculate month-over-month growth rate for each product
def calculate_growth_rate(data):
    growth_rate_data = data.copy()
    growth_rate_data['prev_revenue'] = growth_rate_data.groupby('product')['revenue'].shift(1)
    growth_rate_data['growth_rate'] = (growth_rate_data['revenue'] - growth_rate_data['prev_revenue']) / growth_rate_data['prev_revenue']
    return growth_rate_data

# Plot monthly revenue trend for each product
def plot_trend(data):
    products = data['product'].unique()
    fig, ax = plt.subplots(figsize=(10, 6))
    for product in products:
        product_data = data[data['product'] == product].sort_values('month')
        ax.plot(product_data['month'].dt.to_timestamp(), product_data['revenue'], label=product)
    ax.set_xlabel('Month')
    ax.set_ylabel('Revenue')
    ax.set_title('Monthly Revenue Trend')
    ax.legend()
    plt.savefig('outputs/revenue_trend.png')

# Analyze growth rates to identify the product with the fastest growth rate
def analyze_growth_rate(data):
    growth_rate_data = calculate_growth_rate(data)
    avg_growth_rate = growth_rate_data.groupby('product')['growth_rate'].mean().reset_index()
    fastest_growing_product = avg_growth_rate.loc[avg_growth_rate['growth_rate'].idxmax()]
    print(f"The fastest growing product is {fastest_growing_product['product']} with an average growth rate of {fastest_growing_product['growth_rate']:.2f}")
    print(f"Average revenue: {data['revenue'].mean():.2f}")
    print(f"Total revenue: {data['revenue'].sum():.2f}")

# Main function
def main():
    file_name = 'uploads/sales.csv'
    data = load_data(file_name)
    prepared_data = prepare_data(data)
    revenue_data = calculate_revenue(prepared_data)
    plot_trend(revenue_data)
    analyze_growth_rate(revenue_data)

if __name__ == "__main__":
    main()